@model List<CustomerHub.Models.Customer>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="mb-1">Customer Hub - CI/CD with Jenkins</h1>
       <p class="text-muted mb-0">Customer details management.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Add Customer</a>
</div>

<!-- Desktop / Tablet Table -->
<div class="table-responsive d-none d-md-block">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>City</th>
                <th>Joined On</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.FullName</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td>@customer.City</td>
                    <td>@customer.JoinedOn</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile Cards -->
<div class="d-md-none">
    @foreach (var customer in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-2">@customer.FullName</h5>

                <p class="mb-1">
                    <strong>Email:</strong><br />
                    @customer.Email
                </p>

                <p class="mb-1">
                    <strong>Phone:</strong><br />
                    @customer.Phone
                </p>

                <p class="mb-1">
                    <strong>City:</strong><br />
                    @customer.City
                </p>

                <p class="mb-3">
                    <strong>Joined On:</strong><br />
                    @customer.JoinedOn
                </p>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning btn-sm w-50">Edit</a>
                    <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-danger btn-sm w-50">Delete</a>
                </div>
            </div>
        </div>
    }
</div>